# =============================================================================
# Gibson store - environment template
#
# Copy this file to .env and fill in real values:   cp .env.example .env
#
# .env IS GIT-IGNORED AND MUST NEVER BE COMMITTED. It holds database and SMTP
# credentials. Only this template (with placeholders) is tracked in git.
#
# config/env.php loads .env at the repository root when it exists. A real
# environment variable set by the platform (Docker Compose, Railway, Render)
# ALWAYS WINS over the same key in .env. With no .env and no environment
# variables the app keeps the original XAMPP defaults:
# localhost / root / empty password / database "lenguajes".
# =============================================================================

# --- Database (read by config/database.php) -----------------------------------
# XAMPP default: host "localhost", user "root", empty password, "lenguajes".
# Docker Compose overrides DB_HOST with the service name "db".
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lenguajes

# --- Outgoing SMTP mail (read by server/send_email.php) -----------------------
# Required to actually send the contact form: SMTP_HOST, SMTP_USER, SMTP_PASS,
# MAIL_FROM and MAIL_TO. SMTP_PORT / SMTP_SECURE default to 465 / ssl.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
# Placeholder only - use your own account, never a real one.
SMTP_USER=your-smtp-user@gmail.com
# Use a provider app password, never the account password. Placeholder only.
SMTP_PASS=your-app-password-here
# Authenticated sender / envelope identity.
MAIL_FROM=no-reply@example.com
# Recipient of contact-form messages.
MAIL_TO=no-reply@example.com

# --- Docker Compose only (not read by the PHP app) ----------------------------
# Password for the bundled MySQL container (root user).
# DB_PASS above MUST match this value when running through Docker Compose.
MYSQL_ROOT_PASSWORD=gibson_local_root
# Host port the web container is published on (the container listens on 80).
WEB_PORT=8080
